{
  "name": "ma-vpn-desktop",
  "version": "2.8.4",
  "description": "MA VPN — کلاینت حرفه‌ای ویندوز ۶۴بیت",
  "main": "dist/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "fetch-core": "node scripts/fetch-core.mjs",
    "pack": "electron-builder --x64 --publish never",
    "release:win": "npm run fetch-core && npm run build && npm run pack"
  },
  "dependencies": {
