<?xml version="1.0" encoding="utf-8"?>
<!--
  روشن (Light) palette. MIRROR of ui/theme/Color.kt (Palette.Light) and of the CSS custom properties in
  design/preview/index.html. Three mirrors, one truth - check-theme.sh fails the build on drift.

  This file is the *default* (values/), and it is the LIGHT palette: an Android resource qualifier
  works by override, so whatever lives in values/ is also what a pre-21 device, a launcher widget,
  or a malformed night config falls back to. Light-as-default is the safe fallback (a white window
  background on a light-mode phone is correct; on a dark-mode phone the night file overrides it).

  icon_field is deliberately NOT inverted: the M•A slab tile stays graphite in both themes (Android
  adapts the *themed* icon through @drawable/ic_launcher_monochrome, which does invert). A launcher
  that repaints itself per theme is how you lose brand recognition on the home screen.
-->
<resources>
    <color name="bg">#FFF5F7F9</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_high">#FFEDF1F5</color>
    <color name="well">#FFE9EEF3</color>
    <color name="line">#FFDDE4EA</color>
    <color name="hairline">#0E0D151C</color>
    <color name="bezel_top">#FFFFFFFF</color>
    <color name="bezel_bottom">#FFCFD8E0</color>
    <color name="text">#FF0D151C</color>
    <color name="muted">#FF4B5C6B</color>
    <color name="muted_faint">#FF607182</color>
