<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="meelano_prefs.xml" />
        <exclude domain="file" path="feed" />
        <exclude domain="cache" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- a new phone gets the same preference, then re-fetches both feeds on first launch -->
        <include domain="sharedpref" path="meelano_prefs.xml" />
        <exclude domain="file" path="feed" />
        <exclude domain="cache" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
