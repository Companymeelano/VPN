<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Three layers, deliberately:
        background  = flat ink (no gradient: it bands once the launcher crops to the 66% safe zone)
        foreground  = the rendered 3D monogram, pre-inset to the safe zone at build time
                      (design/flags/../icons pipeline; see docs/BRAND.md §1) - the depth is baked into
                      the PNG, so the mark still reads as an object and not as a sticker
        monochrome  = the same M+tunnel as a pure-alpha vector, which is what Android 13 uses for
                      Themed Icons; the system tints it, so it must carry no colour of its own
      The foreground exists at all five densities; the launcher picks one and never upscales.
    -->
    <background android:drawable="@color/bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
