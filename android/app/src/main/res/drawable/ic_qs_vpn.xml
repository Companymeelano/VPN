        android:strokeColor="@color/tile_icon" android:strokeWidth="2.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000" />
    <path android:pathData="M15.8,17.8 L18.8,7.2 L21.8,17.8"
