<?xml version="1.0" encoding="utf-8"?>
<!--
  THE MARK: an M whose middle is a tunnel portal. One line, one gesture, nothing else.

  Geometry is authored on a 24-unit grid (feet at y=18, apex at y=11.9, portal radius 2.1) and
  scaled x3 into the 108 adaptive canvas, so it lands inside the 66% safe zone with ~14% margin on
  every mask. Alpha-only artwork: Android 13 tints this for Themed Icons, and a tint can only work
  if the mark carries no colour of its own.

  Why a tunnel instead of a padlock: a lock says "locked". The promise of this product is that you
  still get THROUGH - the portal under the M is the whole brand argument, drawn once.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3"
        android:scaleY="3"
        android:translateX="18"
        android:translateY="18">
        <path
            android:pathData="M6.3,18.0 L6.3,6.9 L12.0,11.9 L17.7,6.9 L17.7,18.0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M9.9,18.0 L9.9,14.9 A2.1,2.1 0 0 1 14.1,14.9 L14.1,18.0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
