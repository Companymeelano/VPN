<!-- Brand control icon: stroke-only on the 24 grid, 2.1 weight, round caps — same drawing hand as
     ic_stat_vpn / ic_qs_vpn, because a mixed icon set (some filled, some outlined) is what makes an
     app look assembled from a template. The bisected circle reads as "follow the system": half day,
     half night. Tinted by the caller, so no colour lives here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:pathData="M12,4.2 A7.8,7.8 0 1,1 4.2,12 A7.8,7.8 0 1,1 12,4.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
    />
    <path
        android:pathData="M12,4.2 A7.8,7.8 0 0,1 12,19.8 Z"
        android:fillColor="#FFFFFFFF"
    />
</vector>
