<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon. The system uses ONLY the alpha channel at ~18dp and tints it, so: no "cut-outs"
  drawn with a coloured stroke (an opaque black stroke is opaque alpha - it will not punch a hole),
  nothing thinner than 1.6 units, and the arcs simplified to a single opening.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
