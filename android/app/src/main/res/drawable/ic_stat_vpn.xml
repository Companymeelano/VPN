        android:pathData="M12,3.1 L5.4,5.6 L5.4,12.1 C5.4,16 8.1,19 12,20.4 C15.9,19 18.6,16 18.6,12.1 L18.6,5.6 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M8.8,14.2 A3.4,3.4 0 0 1 15.2,14.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
