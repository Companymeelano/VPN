# The control panel must be reachable (it is the only admin surface on shared hosting), but nothing
# else in this folder may be served. <Files> sections override the directory-level Require, so the two
# entry points below work while -Indexes and everything else stay closed.

Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied

  <Files "index.php">
    Require all granted
  </Files>
  <Files "hash.php">
    Require all granted
  </Files>
</IfModule>

<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "index.php">
    Allow from all
  </Files>
  <Files "hash.php">
    Allow from all
  </Files>
</IfModule>

# The panel takes a password on this folder; a login brute-force should not be free.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Referrer-Policy "no-referrer"
</IfModule>
