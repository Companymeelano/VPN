# APK files must be downloadable, but never listable, and the .sha256 sidecars are private.
Options -Indexes

<FilesMatch "\.(sha256|lock)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order deny,allow
Deny from all</IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    # keep caches short: a stale APK copy is an integrity problem
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
</IfModule>
