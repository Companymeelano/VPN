# CI-built engine binary (30MB+ of .so): produced by the apk.yml core job, never committed -
# rebuilding it at the pinned libXray tag is deterministic, and a blob in git is forever.
/android/app/libs/*.aar

# runtime artifacts of the feed endpoint (created on the host, never committed)
/backend/v/data/cache/
/backend/v/data/locks/
/backend/v/data/ratelimit/
/backend/v/data/log/
/backend/v/data/*.json
/backend/v/data/vip_raw.txt
/backend/v/data/fixtures/*.out
/backend/v/apk/*
!/backend/v/apk/.htaccess
# local overrides that contain secrets
/backend/v/config.local.php
/backend/v/sources.local.php
/backend/v/admin/.env
# scratch (the whole tools/ dir used to be scratch; it is not any more - tools/check-theme.py is a
# CI gate now, so only throwaways inside tools/scratch/ are ignored)
/tools/scratch/
*.log
.DS_Store

# build outputs (the APK is distributed through the host /v/apk/, not through git)
# generated by apk.yml from the public verified feed; never retain expiring node credentials in Git
/android/app/src/main/assets/public-bootstrap.txt
/android/**/build/
/android/**/.gradle/
/android/local.properties
/android/keystore.properties
*.keystore
*.jks

# iOS: همان قاعده‌ی AAR اندروید - هسته‌ی باینری (LibXray.xcframework، ۳۰MB+) هرگز در git نمی‌آید؛
# tools/build-libxray-ios.sh آن را در همان تگ پین‌شده می‌سازد.
/ios/LibXray.xcframework/
# پروژه‌ی Xcode تولیدشده از ios/project.yml (XcodeGen) است؛ pbxproj در git سم است.
/ios/*.xcodeproj/
/ios/MeelanoVPN/Info.plist
/ios/MeelanoVPN/MeelanoVPN.entitlements
/ios/MeelanoVPNTunnel/Info.plist
/ios/MeelanoVPNTunnel/MeelanoVPNTunnel.entitlements
/ios/build/
/ios/Payload/
*.ipa
